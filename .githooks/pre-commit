#!/usr/bin/env bash
# Blocks commits that would publish secrets or private AgentMesh endpoints (the repo is public).
# Enable once per clone:  make setup   (or: git config core.hooksPath .githooks)
set -euo pipefail

fail=0
report() { echo "pre-commit: BLOCKED - $1" >&2; fail=1; }

# Secret assignments with a value (KEY=something), in any file type.
SECRET_RE='(AZURE_CLIENT_SECRET|AZURE_DEVOPS_PAT|ACTION_APPROVAL_SIM_SECRET|ACTION_APPROVAL_SECRET|HITL_APPROVAL_SECRET|POSTGRES_PASSWORD|REDIS_ACCESS_KEY|APPLICATIONINSIGHTS_CONNECTION_STRING)[[:space:]]*[:=][[:space:]]*["'"'"']?[^][:space:]"'"'"'#)$<{\\]'
# Browser-exposed variables must never hold keys.
VITE_RE='VITE_[A-Z0-9_]*(KEY|SECRET|TOKEN|PAT|PASSWORD)[A-Z0-9_]*[[:space:]]*[:=][[:space:]]*["'"'"']?[^[:space:]"'"'"'#]'
# Real Zensar mailboxes (the repo only uses @zensar.example and GitHub noreply addresses).
MAIL_RE='[A-Za-z0-9._%+-]+@zensar\.com'
# Private platform endpoints and credentialed feed URLs.
HOST_RE='azurecontainerapps\.io|jollystone-|kindbeach-|corp\.internal|cognitiveservices\.azure\.com|https://[^/@[:space:]]+:[^@[:space:]]+@pkgs\.dev\.azure\.com'

while IFS= read -r -d '' path; do
  base=$(basename "$path")
  case "$path" in
    agentmesh/hosts/*|inputs/*) report "$path is a local-only path (exported host or kit input)"; continue ;;
  esac
  case "$base" in
    .env.example) ;;
    .env|.env.*) report "$path is an env file"; continue ;;
    *.AzureVpnProfile*) report "$path is a VPN profile"; continue ;;
  esac
  # The hook itself contains the patterns.
  [ "$path" = ".githooks/pre-commit" ] && continue
  content=$(git show ":$path" 2>/dev/null | LC_ALL=C tr -d '\000') || continue
  if printf '%s' "$content" | grep -En "$SECRET_RE" > /dev/null; then
    report "$path assigns a secret value (line $(printf '%s' "$content" | grep -En "$SECRET_RE" | head -1 | cut -d: -f1))"
  fi
  if printf '%s' "$content" | grep -En "$VITE_RE" > /dev/null; then
    report "$path puts a key/secret/token in a VITE_ variable"
  fi
  if printf '%s' "$content" | grep -Ein "$MAIL_RE" > /dev/null; then
    report "$path contains a real @zensar.com email address (line $(printf '%s' "$content" | grep -Ein "$MAIL_RE" | head -1 | cut -d: -f1))"
  fi
  if printf '%s' "$content" | grep -Ein "$HOST_RE" > /dev/null; then
    report "$path contains a private AgentMesh endpoint (line $(printf '%s' "$content" | grep -Ein "$HOST_RE" | head -1 | cut -d: -f1))"
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: nothing was committed. Remove the value, or keep the file out of git." >&2
  exit 1
fi
