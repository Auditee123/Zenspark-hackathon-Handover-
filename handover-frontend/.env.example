# true = dummy data, no backend needed (use this for the wireframe demo)
# false = call the exported AgentMesh agents
VITE_USE_MOCK=true

# Where the exported AgentMesh agent host runs (startup.sh starts it on 8000)
VITE_AGENTMESH_URL=http://localhost:8000

# AgentMesh agent names, one per step. Change these to the names you save in the Builder.
VITE_AGENT_INGESTION=handover-ingestion
VITE_AGENT_GAP_FINDER=handover-gap-finder
VITE_AGENT_KT_PLANNER=handover-kt-planner
VITE_AGENT_KT_SCHEDULER=handover-kt-scheduler
VITE_AGENT_KT_SESSION=handover-kt-session
VITE_AGENT_ASSESSMENT=handover-assessment
VITE_AGENT_REPORT=handover-report
